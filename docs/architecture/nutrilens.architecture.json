  "cards": [
    {
      "dot": "cyan",
      "title": "資料流的單一方向",
      "items": [
        "疾病門檻的數字只從後端出去，前端只負責比大小",
        "每日目標與單餐上限隨 /records 一起下發",
        "store 是畫面唯一的資料來源，不再有第二套預設值"
      ]
    },
    {
      "dot": "rose",
      "title": "需要注意的邊界",
      "items": [
        "後端預設只讓這台電腦連，其他裝置要加 --lan 或走 cloudflared",
        "AuthGate 擋住所有子畫面，後端沒開整個 App 就不能用",
        "Gemini 與 Google Places 每次呼叫都計費"
      ]
    },
    {
      "dot": "emerald",
      "title": "資料的真實狀況",
      "items": [
        "資料庫檔放在 %LOCALAPPDATA%\\NutriLens，避開 OneDrive 同步",
        "Render 上的版本磁碟每次部署都會清空，帳號與紀錄跟著消失",
        "TFDA 是食材樣本庫，查不到便當與滷肉飯這類菜色"
      ]
    }
  ]
