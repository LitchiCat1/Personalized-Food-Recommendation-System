# 本機執行用的設定。複製成 .env.local 再填入實際值。
# .env.local 已被 .gitignore 排除，不會進版本庫。
#
#   cp backend/.env.local.example backend/.env.local

# ── 資料庫：本機 SQLite 檔案 ────────────────────────────────
# 帳號、健康檔案、飲食紀錄、店家菜單快取都存在這一個檔案，不用安裝任何資料庫。
# 不填就用預設位置：%LOCALAPPDATA%\NutriLens\nutrilens.db
# （刻意不放在專案資料夾：專案在 OneDrive 裡，同步中的 SQLite 檔可能被弄壞）
# 設成空字串（DATABASE_PATH=）表示不用資料庫，資料只存在記憶體，重啟就沒了。
# 用 Claude 桌面版（MSIX 套件）跑後端、又用工作排程器或一般終端機跑時，一定要設到 AppData 以外：
# Windows 會把從 Claude 啟動的程式寫進 AppData 的檔案導到 Claude 自己的資料夾，兩邊會各用一個資料庫。
# DATABASE_PATH=C:\Users\<你的帳號>\NutriLensData\nutrilens.db
# 本版本只支援 SQLite。若環境繼承了非空 DATABASE_URL，後端會拒絕啟動，
# 不會改連 PostgreSQL，也不會靜默切換到另一份 SQLite 檔案。
#
# 自動備份：後端開著時每 24 小時備份一次到資料庫旁邊的 backups 資料夾（檔名有 -auto-），
# 只留最近 30 份自動備份；手動備份和升級資料庫結構前的備份不會被清掉。
# AUTO_BACKUP_HOURS=24          # 設 0 關掉；最少 1 小時
# AUTO_BACKUP_KEEP=30
# 另外複製一份到別的硬碟或雲端硬碟資料夾（硬碟壞掉時還有一份）。備份檔可以放 OneDrive，
# 正在使用的資料庫不要放。
# AUTO_BACKUP_COPY_DIR=D:\NutriLensBackups

# ── 登入驗證 ────────────────────────────────────────────────
# 帳號存在上面的資料庫裡（auth_users 表）。設 false 就不用登入，直接用 demo_user。
AUTH_REQUIRED=true
# 其他裝置（同一個 Wi-Fi、cloudflared 網址）註冊時要輸入的邀請碼。
# 留空表示其他裝置只能登入、不能註冊；在這台電腦上永遠可以註冊。
SIGNUP_CODE=
# 設 true 就開放所有人直接註冊、不用邀請碼。拿到網址的人都能註冊並使用 Gemini 額度。
OPEN_SIGNUP=false

# ── 外部服務 ────────────────────────────────────────────────
# 沒有金鑰時，掃描辨識、店家搜尋與菜單分析會失敗並說明原因，其餘功能照常。
# USDA FoodData Central API（選填，僅後端使用；不會送到前端）。目前只用於
# 受限的 server-side API replay/client，尚未開啟自動網路補全。請把私有 key
# 放在這個被 gitignore 的檔案，或由 Windows 工作排程的環境注入；不要把
# USDA KEY.txt 放進 frontend、Expo 變數、提示詞或日誌。未設定時仍使用內附
# USDA FNDDS 快照，不會在啟動時自行下載資料。
# USDA_FDC_API_KEY=
# 第三層營養補全仍預設關閉。正式啟用前必須使用至少 32 bytes 的伺服器端
# signer secret；它只用來簽發短效 scan authority，不可放到前端或提交到 git。
# NUTRITION_AUTHORITY_SECRET=
# NUTRITION_ENRICHMENT_ROUTE_ENABLED=false
# NUTRITION_SCAN_CONTEXT_TTL_SECONDS=120
# FDC Search 候選參考路由預設關閉；只查伺服器保存、且官方本地資料庫確認未命中的高信心食材。
# 每次掃描最多 4 個項目／12 次 Search／25 秒，並以 SQLite 保存 owner-bound immutable snapshot。
# 開啟前仍須完成來源 rights、confirmation UI 與手機端 bounded 驗收。
# FDC_CANDIDATE_ROUTE_ENABLED=false
# RATE_LIMIT_FDC_CANDIDATE_CALLS=4
# FDC_CONFIRMATION_ROUTE_ENABLED=false
# FDC profile preview/accept 仍預設關閉；它們只接受 server-owned references，
# 不接受前端自帶 FDC ID、Detail document、重量或營養 profile。開啟前必須
# 完成來源政策、rights、SQLite restart/rollback 與手機端 bounded 驗收。
# FDC_PROFILE_PREVIEW_ROUTE_ENABLED=false
# FDC_PROFILE_ACCEPT_ROUTE_ENABLED=false
# 固定 FDC Detail replay 仍預設關閉；開啟前必須有 server-side USDA_FDC_API_KEY，
# 並先完成來源政策、profile/portion 接續與手機端驗收。它不接受客戶端自帶 FDC ID。
# FDC_DETAIL_ROUTE_ENABLED=false
# All AI features prefer the project-root key.txt when it exists.
# Copy key.txt.example to key.txt, then paste the privately supplied keys there.
# For a secret mounted outside the project, set its absolute path:
# AI_RELAY_KEYS_FILE=/run/secrets/nutrilens-ai
# Alternatively set ALL THREE variables below (overrides key.txt):
# AI_BASE_URL=https://cdn.sta1n.cn/v1
# AI_MODEL=[AN]gemini-4-hydrogen-high
# AI_API_KEYS=
# Legacy provider settings below apply only when relay configuration is absent.
GEMINI_API_KEYS=
# 後端呼叫 Places（按次計費）用。只放在後端，不會進網站的程式碼。
GOOGLE_PLACES_API_KEY=
# 網頁版地圖用的「瀏覽器金鑰」（選填）。打包網站時會寫進 JS，任何人都讀得到，
# 所以要另外建一把，在 Google Cloud 限制成只能用 Maps JavaScript API、只認自己的網址。
# 不要填跟 GOOGLE_PLACES_API_KEY 同一把。改完要重新打包網站（build:local -- --clear）。
GOOGLE_MAPS_BROWSER_KEY=
# ChatGPT（OpenAI API，選填）。只用在菜單（依店名估菜單、菜單照片辨識）：
# 有設就先問 ChatGPT，失敗、額度用完或說看不出來時才改問 Gemini；沒設就只用 Gemini。
# 在 https://platform.openai.com/api-keys 建立。API 要另外儲值，ChatGPT Plus 訂閱不含 API 額度。
OPENAI_API_KEY=
# 選填，逗號分隔、依序嘗試。沒設就用 gpt-4.1-mini，帳號沒有這個模型再換 gpt-4o-mini。
# OPENAI_MODELS=

# ── 其他 ────────────────────────────────────────────────────
# 台灣時區。不設的話日期會用 UTC 算，跨日的紀錄會歸錯天。
APP_UTC_OFFSET_HOURS=8
# 讓同一個區域網路的其他裝置連得進來時，把前端網址列在這裡（逗號分隔）。
# 不設的話只放行 localhost。
ALLOWED_ORIGINS=
