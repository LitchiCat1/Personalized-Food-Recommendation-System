# 本機執行用的設定。複製成 .env.local 再填入實際值。
# .env.local 已被 .gitignore 排除，不會進版本庫。
#
#   cp backend/.env.local.example backend/.env.local

# ── 資料庫：本機 SQLite 檔案 ────────────────────────────────
# 帳號、健康檔案、飲食紀錄、店家菜單快取都存在這一個檔案，不用安裝任何資料庫。
# 不填就用預設位置：%LOCALAPPDATA%\NutriLens\nutrilens.db
# （刻意不放在專案資料夾：專案在 OneDrive 裡，同步中的 SQLite 檔可能被弄壞）
# 設成空字串（DATABASE_PATH=）表示不用資料庫，資料只存在記憶體，重啟就沒了。
# 用 Claude 桌面版（MSIX 套件）跑後端、又用工作排程器或一般終端機跑時，一定要設到 AppData 以外：
# Windows 會把從 Claude 啟動的程式寫進 AppData 的檔案導到 Claude 自己的資料夾，兩邊會各用一個資料庫。
# DATABASE_PATH=C:\Users\<你的帳號>\NutriLensData\nutrilens.db
# 本機不要設 DATABASE_URL：設了就會改連雲端的 Supabase。只有 Render 要設（在 Render 後台）。

# ── 登入驗證 ────────────────────────────────────────────────
# 帳號存在上面的資料庫裡（auth_users 表）。設 false 就不用登入，直接用 demo_user。
AUTH_REQUIRED=true
# 其他裝置（同一個 Wi-Fi、cloudflared 網址）註冊時要輸入的邀請碼。
# 留空表示其他裝置只能登入、不能註冊；在這台電腦上永遠可以註冊。
SIGNUP_CODE=
# 設 true 就開放所有人直接註冊、不用邀請碼。拿到網址的人都能註冊並使用 Gemini 額度。
OPEN_SIGNUP=false

# ── 外部服務 ────────────────────────────────────────────────
# 沒有金鑰時，掃描辨識、店家搜尋與菜單分析會失敗並說明原因，其餘功能照常。
GEMINI_API_KEYS=
# 後端呼叫 Places（按次計費）用。只放在後端，不會進網站的程式碼。
GOOGLE_PLACES_API_KEY=
# 網頁版地圖用的「瀏覽器金鑰」（選填）。打包網站時會寫進 JS，任何人都讀得到，
# 所以要另外建一把，在 Google Cloud 限制成只能用 Maps JavaScript API、只認自己的網址。
# 不要填跟 GOOGLE_PLACES_API_KEY 同一把。改完要重新打包網站（build:local -- --clear）。
GOOGLE_MAPS_BROWSER_KEY=

# ── 其他 ────────────────────────────────────────────────────
# 台灣時區。不設的話日期會用 UTC 算，跨日的紀錄會歸錯天。
APP_UTC_OFFSET_HOURS=8
# 讓同一個區域網路的其他裝置連得進來時，把前端網址列在這裡（逗號分隔）。
# 不設的話只放行 localhost。
ALLOWED_ORIGINS=
