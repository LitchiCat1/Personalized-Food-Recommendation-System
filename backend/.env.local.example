# 本機執行用的設定。複製成 .env.local 再填入實際值。
# .env.local 已被 .gitignore 排除，不會進版本庫。
#
#   cp backend/.env.local.example backend/.env.local
#
# 三種資料庫擇一。什麼都不填也能跑，只是資料存在記憶體裡，重啟就沒了。

# ── 方案 A：直接用雲端的 Supabase（推薦，不必安裝任何東西）──────
# Supabase → Connect → Session pooler 的連線字串
DATABASE_URL=

# ── 方案 B：本機 Postgres ────────────────────────────────────
# 需要自己安裝 PostgreSQL。本機連線不需要 SSL，程式會自動判斷。
# DATABASE_URL=postgresql://postgres:你的密碼@localhost:5432/nutrilens

# ── 方案 C：本機 MongoDB ─────────────────────────────────────
# 什麼都不設就會試 mongodb://localhost:27017，連不到就退回記憶體。
# MONGO_URI=mongodb://localhost:27017

# ── 登入驗證 ────────────────────────────────────────────────
# 本機開發要關掉驗證的話設 false；設 true 就需要下面兩個值。
SUPABASE_AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── 外部服務 ────────────────────────────────────────────────
# 沒有金鑰時，店家搜尋與菜單分析會失敗並說明原因，其餘功能照常。
GEMINI_API_KEYS=
GOOGLE_PLACES_API_KEY=

# ── 其他 ────────────────────────────────────────────────────
# 台灣時區。不設的話日期會用 UTC 算，跨日的紀錄會歸錯天。
APP_UTC_OFFSET_HOURS=8
# 讓同一個區域網路的其他裝置連得進來時，把前端網址列在這裡（逗號分隔）。
# 不設的話只放行 localhost。
ALLOWED_ORIGINS=
