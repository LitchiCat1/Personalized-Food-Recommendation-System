# 本機後端的位址。手機用 Expo Go 測試時，改成電腦在區域網路的 IP，例如 http://192.168.1.10:5000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
# 預設要登入（帳號存在本機資料庫）。設 false 就跳過登入畫面，直接用 demo_user。
EXPO_PUBLIC_AUTH_REQUIRED=true
# 網頁版地圖用的 Google Maps 瀏覽器金鑰（選填）。會寫進網站的 JS，任何人都讀得到：
# 另外建一把、限制成只能用 Maps JavaScript API 與自己的網址，不要跟後端的
# GOOGLE_PLACES_API_KEY 用同一把。也可以改填在 backend/.env.local 的 GOOGLE_MAPS_BROWSER_KEY。
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# 第三層網路營養補全預設關閉。只有後端 route、authority token、來源權利與
# policy revision 都已核准並完成 live validation 後，才可在受控部署中開啟。
EXPO_PUBLIC_NUTRITION_ENRICHMENT_ENABLED=false
# 不可填 Tavily URL 或 API key；這兩個欄位只接受後端核准的 source policy metadata。
EXPO_PUBLIC_NUTRITION_SOURCE_POLICY_ID=
EXPO_PUBLIC_NUTRITION_SOURCE_POLICY_REVISION=
# 只取得由伺服器保存的 USDA 候選參考，不代表辨識或營養資料已確認。
# 前後端必須分別明確開啟；預設關閉。
EXPO_PUBLIC_FDC_CANDIDATE_SEARCH_ENABLED=false
# 逐項候選確認需另外開啟；服務端 FDC_CONFIRMATION_ROUTE_ENABLED 也必須明確開啟。
EXPO_PUBLIC_FDC_CONFIRMATION_ENABLED=false
# 固定 USDA Detail 的唯讀 profile preview 需另外開啟；服務端 FDC_PROFILE_PREVIEW_ROUTE_ENABLED 也必須明確開啟。
EXPO_PUBLIC_FDC_PROFILE_PREVIEW_ENABLED=false
