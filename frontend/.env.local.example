# 本機後端的位址。手機用 Expo Go 測試時，改成電腦在區域網路的 IP，例如 http://192.168.1.10:5000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
# 預設要登入（帳號存在本機資料庫）。設 false 就跳過登入畫面，直接用 demo_user。
EXPO_PUBLIC_AUTH_REQUIRED=true
# 網頁版地圖用的 Google Maps 瀏覽器金鑰（選填）。會寫進網站的 JS，任何人都讀得到：
# 另外建一把、限制成只能用 Maps JavaScript API 與自己的網址，不要跟後端的
# GOOGLE_PLACES_API_KEY 用同一把。也可以改填在 backend/.env.local 的 GOOGLE_MAPS_BROWSER_KEY。
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
