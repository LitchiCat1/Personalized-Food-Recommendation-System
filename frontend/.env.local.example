# 本機後端的位址。手機用 Expo Go 測試時，改成電腦在區域網路的 IP，例如 http://192.168.1.10:5000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
# 預設要登入（帳號存在本機資料庫）。設 false 就跳過登入畫面，直接用 demo_user。
EXPO_PUBLIC_AUTH_REQUIRED=true
# 網頁版地圖用的 Google Maps 金鑰（選填）。可以跟後端的 GOOGLE_PLACES_API_KEY 用同一把，
# 但那把金鑰要在 Google Cloud 開啟 Maps JavaScript API。改完要重新啟動網站。
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
