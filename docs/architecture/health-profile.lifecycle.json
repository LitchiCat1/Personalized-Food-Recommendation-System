{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "健康檔案的生命週期",
    "subtitle": "一個帳號的健康檔案會經過哪些狀態，又在哪裡卡住",
    "output": "docs/architecture/health-profile.html",
    "visual_preset": "blueprint",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy",
        "label": "正常路徑",
        "focus": [
          "anon",
          "signedin",
          "onboarding",
          "complete"
        ],
        "note": "初次設定填完，每日目標與單餐上限才照本人的身體狀況算。"
      },
      {
        "id": "blank",
        "label": "空白檔案",
        "focus": [
          "signedin",
          "blank",
          "onboarding"
        ],
        "note": "帳號要先有一份檔案，其他 API 才不會 404；那份檔案的醫療欄位一律是空的。"
      },
      {
        "id": "legacy",
        "label": "舊帳號的補正",
        "focus": [
          "legacy",
          "healed",
          "complete",
          "rejected"
        ],
        "note": "選項收斂後，舊值會在讀取時就地補正，否則使用者會被鎖在存不了檔的表單裡。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "主要流程"
    },
    {
      "id": "repair",
      "label": "既有帳號的補正"
    },
    {
      "id": "terminal",
      "label": "存不了檔"
    }
  ],
  "states": [
    {
      "id": "anon",
      "type": "start",
      "label": "未登入",
      "sublabel": "只看得到登入頁",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "signedin",
      "type": "active",
      "label": "已登入",
      "sublabel": "取得登入 token",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "blank",
      "type": "waiting",
      "label": "空白檔案",
      "sublabel": "疾病與過敏原皆為空",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "profile_complete=false"
    },
    {
      "id": "onboarding",
      "type": "decision",
      "label": "初次設定",
      "sublabel": "身體數值與疾病條件",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "complete",
      "type": "success",
      "label": "已填寫",
      "sublabel": "目標依本人狀況計算",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "profile_complete=true"
    },
    {
      "id": "legacy",
      "type": "neutral",
      "label": "舊帳號",
      "sublabel": "值已不在目前選單裡",
      "lane": "repair",
      "col": 0,
      "step": "06"
    },
    {
      "id": "healed",
      "type": "active",
      "label": "讀取時補正",
      "sublabel": "正規化後寫回",
      "lane": "repair",
      "col": 2,
      "step": "07"
    },
    {
      "id": "rejected",
      "type": "failure",
      "label": "存檔被退回",
      "sublabel": "身體數值超出合理範圍",
      "lane": "terminal",
      "col": 1,
      "step": "08"
    }
  ],
  "transitions": [
    {
      "id": "login",
      "from": "anon",
      "to": "signedin",
      "variant": "security"
    },
    {
      "id": "seed",
      "from": "signedin",
      "to": "blank",
      "variant": "default",
      "route": "straight"
    },
    {
      "id": "ask",
      "from": "blank",
      "to": "onboarding",
      "variant": "emphasis"
    },
    {
      "id": "filled",
      "from": "onboarding",
      "to": "complete",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "old",
      "from": "signedin",
      "to": "legacy",
      "variant": "dashed"
    },
    {
      "id": "normalize",
      "from": "legacy",
      "to": "healed",
      "variant": "default"
    },
    {
      "id": "recovered",
      "from": "healed",
      "to": "complete",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "outofrange",
      "from": "complete",
      "to": "rejected",
      "variant": "security",
      "fromSide": "right",
      "toSide": "right",
      "via": [
        [
          800,
          157
        ],
        [
          800,
          479
        ]
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "空白檔案為什麼存在",
      "items": [
        "帳號沒有檔案時其他 API 全部 404，所以要先建一份",
        "那份檔案的疾病與過敏原一定是空陣列",
        "profile_complete=false 讓畫面說得出「這還不是你的資料」"
      ]
    },
    {
      "dot": "emerald",
      "title": "舊帳號要能走回正路",
      "items": [
        "缺 profile_complete 的資料列視為早就填過",
        "不在選單裡的飲食型態在讀取時換掉並寫回",
        "只修寫入路徑救不到已經存在的帳號"
      ]
    },
    {
      "dot": "rose",
      "title": "會卡住的地方",
      "items": [
        "早年存進去的離譜數值會讓整份檔案存不了",
        "連「勾一個疾病」都是送整份檔案，所以一樣被退回",
        "退回訊息要指去編輯資料，因為出問題的欄位不在那一頁"
      ]
    }
  ]
}
